set(CMAKE_SYSTEM_NAME Darwin)
set(CMAKE_SYSTEM_PROCESSOR arm64)
set(CMAKE_C_COMPILER   @IOS_SWIFT_BIN@/clang)
set(CMAKE_CXX_COMPILER @IOS_SWIFT_BIN@/clang++)
set(CMAKE_AR           @IOS_SWIFT_BIN@/llvm-ar)
set(CMAKE_RANLIB       @IOS_SWIFT_BIN@/llvm-ranlib)
# Cross-building on Linux has no install_name_tool; static libs never need it.
set(CMAKE_INSTALL_NAME_TOOL /bin/true)
set(CMAKE_C_FLAGS_INIT   "-target @IOS_TARGET@ -isysroot @IOS_SYSROOT@ -fPIC")
set(CMAKE_CXX_FLAGS_INIT "-target @IOS_TARGET@ -isysroot @IOS_SYSROOT@ -fPIC")
set(CMAKE_TRY_COMPILE_TARGET_TYPE STATIC_LIBRARY)
set(CMAKE_FIND_ROOT_PATH_MODE_PROGRAM NEVER)
set(CMAKE_FIND_ROOT_PATH_MODE_LIBRARY BOTH)
set(CMAKE_FIND_ROOT_PATH_MODE_INCLUDE BOTH)
set(CMAKE_FIND_ROOT_PATH_MODE_PACKAGE BOTH)
